  "dependencies": {
    "@babylonjs/gui-editor": "^7.31.2",
    "@babylonjs/materials": "^7.31.2",
    "@babylonjs/serializers": "^7.31.2",
    "@tauri-apps/api": "2.11.1",
    "@vueuse/core": "^10.6.1",
    "axios": "^1.5.0",
    "babylonjs": "^7.31.2",
    "babylonjs-materials": "^7.31.2",
    "bcryptjs": "3.0.3",
    "bson": "6.10.4",
    "core-js": "^3.8.3",
    "fast-png": "6.4.0",
    "gyronorm": "^2.0.6",
    "js-zip": "^1.0.1",
    "lodash": "^4.17.21",
    "nipplejs": "^0.10.2",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primevue": "^3.32.2",
    "screenfull": "^6.0.2",
    "vue": "^3.2.13",
    "vue-router": "^4.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@babylonjs/core": "^7.31.2",
    "@babylonjs/gui": "^7.31.2",
    "@babylonjs/inspector": "^7.31.2",
    "@babylonjs/loaders": "^7.31.2",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@napi-rs/canvas": "^1.1.0",
    "@tauri-apps/cli": "2.11.5",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "draco3dgltf": "1.5.7",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^8.0.3",
    "meshoptimizer": "1.1.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "1.3.0"
  },
  "resolutions": {
    "rollup": "4.20.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/multi-word-component-names": "off"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn export:world && vite build",
    "build:tauri": "yarn export:world && vite build --mode tauri",
    "serve": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "export:world": "node build/exportWorld.cjs",
    "generate:lod": "node build/generateModelLods.mjs",
    "test:runtime": "node --test tests/localRuntime.test.cjs tests/localTransport.test.cjs",
    "test:runtime:worker": "node tests/localWorker.integration.cjs",
    "test:runtime:gm": "node tests/localBrowser.integration.cjs",
    "test:runtime:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File build/testDesktopRuntime.ps1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
